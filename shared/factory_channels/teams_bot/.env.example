# --- Factory backend -------------------------------------------------------------------------
FACTORY_BACKEND=langgraph                 # or gh-aw
FACTORY_API_URL=http://localhost:8080     # langgraph backend
# FACTORY_HUB_REPO=my-org/factory-hub     # gh-aw backend
# GH_TOKEN=...                            # gh-aw backend: PAT of the relay service account (in FACTORY_RELAY_LOGINS)
FACTORY_POLL_SECONDS=3

# --- Azure Bot (leave empty for local Agents Playground / Bot Framework Emulator) ---------------
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
